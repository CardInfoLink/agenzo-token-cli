{
  "name": "@agenzo/admin-cli",
  "version": "0.1.1",
  "description": "Admin CLI for the Agenzo platform (login, orgs, developers, API keys)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agenzo-admin-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CardInfoLink/agent-token-cli.git"
  },
  "keywords": [
    "cli",
    "agent",
    "agenzo",
    "admin",
    "identity",
    "ai-agent",
    "organization",
    "developer",
    "api-key",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CardInfoLink/agent-token-cli/issues"
  },
  "homepage": "https://github.com/CardInfoLink/agent-token-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "fast-check": "^4.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
